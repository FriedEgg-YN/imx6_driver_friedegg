#!/bin/sh

DAEMON=/usr/bin/imx6-monitor
PIDFILE=/var/run/imx6-monitor.pid
LOGFILE=/var/log/imx6-monitor.log
ARGS="${IMX6_MONITOR_ARGS:--d /dev/video1 -f /dev/fb0 -s /dev/ap3216c -p 8080 -W 800 -H 480 -r 10 -q 75}"

start() {
	printf 'Starting imx6-monitor: '
	if [ ! -x "$DAEMON" ]; then
		echo "missing $DAEMON"
		return 1
	fi
	mkdir -p /var/run /var/log
	# modprobe ap3216c >/dev/null 2>&1 || true
	# modprobe ov5640 >/dev/null 2>&1 || true
	# modprobe mx6s_capture >/dev/null 2>&1 || true
	start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$DAEMON" -- $ARGS >>"$LOGFILE" 2>&1
	status=$?
	[ "$status" -eq 0 ] && echo OK || echo FAIL
	return "$status"
}

stop() {
	printf 'Stopping imx6-monitor: '
	start-stop-daemon -K -q -p "$PIDFILE"
	status=$?
	rm -f "$PIDFILE"
	[ "$status" -eq 0 ] && echo OK || echo FAIL
	return "$status"
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart|reload)
		stop
		start
		;;
	status)
		if [ -f "$PIDFILE" ]; then
			echo "imx6-monitor running: $(cat "$PIDFILE")"
		else
			echo "imx6-monitor stopped"
			exit 1
		fi
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}"
		exit 1
		;;
esac
